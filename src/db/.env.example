# Copy to .env (git-ignored) and replace the placeholders. Never commit .env.
POSTGRES_PASSWORD=change-me-superuser
APP_DB_PASSWORD=change-me-bern-app
# Host port (bound to 127.0.0.1 only)
PG_HOST_PORT=5432
